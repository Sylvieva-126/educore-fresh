# Demo mode uses fictional data and never contacts the Java backend.
EXPO_PUBLIC_DEMO_MODE=true
# Set demo mode to false and use your team's reachable HTTPS Java API origin.
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1
# Optional verified app-link host, without scheme. Custom educore:// links work in native builds.
EXPO_PUBLIC_APP_LINK_HOST=
# A real EAS project UUID is required before native push registration can run.
EXPO_PUBLIC_EAS_PROJECT_ID=
